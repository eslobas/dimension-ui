{
  "$description": "Dimension design tokens. Source of truth: edit here, then run `npm run tokens`.",
  "color": {
    "blue": {
      "300": { "$value": "#8fb6ff" },
      "500": { "$value": "#4f8cff" },
      "600": { "$value": "#2f6fe0" },
      "700": { "$value": "#2457bd" }
    },
    "ink": {
      "950": { "$value": "#07090f" },
      "900": { "$value": "#0d111b" },
      "800": { "$value": "#161c2b" },
      "700": { "$value": "#1e2942" },
      "500": { "$value": "#5b6b8a" },
      "300": { "$value": "#93a2bd" },
      "50": { "$value": "#f3f6fc" }
    },
    "white": { "$value": "#ffffff" },
    "red": { "400": { "$value": "#ff7a7a" }, "600": { "$value": "#c62f2f" } },
    "green": { "400": { "$value": "#4ade80" }, "700": { "$value": "#15803d" } }
  },
  "space": {
    "1": { "$value": "0.25rem" }, "2": { "$value": "0.5rem" }, "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" }, "5": { "$value": "1.25rem" }, "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" }, "10": { "$value": "2.5rem" }, "12": { "$value": "3rem" }
  },
  "radius": {
    "sm": { "$value": "4px" }, "md": { "$value": "8px" }, "lg": { "$value": "12px" }, "full": { "$value": "9999px" }
  },
  "font": {
    "family": {
      "sans": { "$value": "'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" },
      "mono": { "$value": "'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace" }
    },
    "size": {
      "xs": { "$value": "0.75rem" }, "sm": { "$value": "0.875rem" }, "md": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" }, "xl": { "$value": "1.5rem" }, "2xl": { "$value": "2rem" }
    },
    "weight": { "regular": { "$value": "400" }, "medium": { "$value": "500" }, "semibold": { "$value": "600" } }
  },
  "motion": {
    "duration": { "fast": { "$value": "150ms" }, "base": { "$value": "250ms" }, "slow": { "$value": "400ms" } },
    "easing": { "out": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)" } }
  },
  "theme": {
    "dark": {
      "bg": { "$value": "{color.ink.950}" },
      "surface": { "$value": "{color.ink.900}" },
      "surface-raised": { "$value": "{color.ink.800}" },
      "fg": { "$value": "{color.ink.50}" },
      "fg-muted": { "$value": "{color.ink.300}" },
      "border": { "$value": "{color.ink.700}" },
      "border-strong": { "$value": "{color.ink.500}" },
      "accent": { "$value": "{color.blue.500}" },
      "action": { "$value": "{color.blue.600}" },
      "action-hover": { "$value": "{color.blue.700}" },
      "on-action": { "$value": "{color.white}" },
      "focus": { "$value": "{color.blue.300}" },
      "danger": { "$value": "{color.red.400}" },
      "success": { "$value": "{color.green.400}" }
    },
    "light": {
      "bg": { "$value": "{color.white}" },
      "surface": { "$value": "{color.ink.50}" },
      "surface-raised": { "$value": "{color.white}" },
      "fg": { "$value": "{color.ink.950}" },
      "fg-muted": { "$value": "{color.ink.500}" },
      "border": { "$value": "#d5dcea" },
      "border-strong": { "$value": "{color.ink.500}" },
      "accent": { "$value": "{color.blue.700}" },
      "action": { "$value": "{color.blue.600}" },
      "action-hover": { "$value": "{color.blue.700}" },
      "on-action": { "$value": "{color.white}" },
      "focus": { "$value": "{color.blue.600}" },
      "danger": { "$value": "{color.red.600}" },
      "success": { "$value": "{color.green.700}" }
    }
  }
}
